---
import Layout from '../../layouts/Layout.astro';
import DashboardApp from '../../components/dashboard/DashboardApp';

const secret = Astro.params.secret;
const dashboardSecret = import.meta.env.DASHBOARD_SECRET;

if (!dashboardSecret || secret !== dashboardSecret) {
  return Astro.redirect('/404');
}
---

<Layout title="AKRASIA // Dashboard">
  <DashboardApp client:only="react" secret={secret} />
</Layout>

<style is:global>
  select,
  input,
  textarea,
  button {
    background-color: #0a0a0a;
    color: #94a3b8;
    border-color: rgba(0, 240, 255, 0.25);
  }
  select option {
    background-color: #0a0a0a;
    color: #94a3b8;
  }
  input::placeholder {
    color: #475569;
  }
</style>
