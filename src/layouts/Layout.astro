---
import PrivacyConsent from '../components/PrivacyConsent.astro';
import '../styles/global.css';
import '../styles/studio-hub.css';
import '../styles/studio-sidebar.css';
import '../styles/studio-neon-chrome.css';
import '../styles/studio-living-hub.css';
import '../styles/studio-glass-interactions.css';
import '../styles/studio-ambient-glass.css';
import '../styles/studio-screen-depth.css';
import '../styles/studio-hologram-chat.css';
import '../styles/studio-portfolio-redesign.css';
import '../styles/studio-service-scan.css';
import '../styles/studio-future-type.css';
import '../styles/studio-precision.css';
import { pageLang, publicCanonical } from '../lib/public-ui';
export interface Props {
  title?: string; description?: string; ogImage?: string;
  lang?: string; bilingual?: boolean; noindex?: boolean; home?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const htmlLang = Astro.props.lang === 'es' ? 'es' : Astro.props.lang === 'en' ? 'en' : pageLang(Astro.url);
const english = htmlLang === 'en';
const {
  title = english ? 'AI audiovisual production | Akrasia Studio' : 'Producción audiovisual con IA | Akrasia Studio',
  description = english ? 'Audiovisual production and creative direction with AI. Content, VFX, post-production and sound design.' : 'Producción audiovisual y dirección creativa con IA. Contenido, VFX, postproducción y diseño sonoro.',
  ogImage = '/img/og-akrasia.png',
  bilingual = true, noindex = false,
} = Astro.props;
const canonicalURL = publicCanonical(Astro.url.pathname, htmlLang);
const socialImage = new URL(ogImage, 'https://akrasia.studio').href;
const verificationValue = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '').trim();
const googleVerification = /^[A-Za-z0-9_-]{20,200}$/.test(verificationValue) ? verificationValue : '';
const organization = {
  '@context': 'https://schema.org', '@type': 'Organization',
  '@id': 'https://akrasia.studio/#organization',
  name: 'AKRASIA STUDIO', url: 'https://akrasia.studio', email: 'info@akrasia.studio',
  logo: 'https://akrasia.studio/favicon.svg',
};
const structuredData = [organization, ...(Array.isArray(Astro.props.structuredData) ? Astro.props.structuredData : Astro.props.structuredData ? [Astro.props.structuredData] : [])];
---
<!doctype html>
<html class="dark" lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />
    {bilingual && <>
      <link rel="alternate" hreflang="es" href={publicCanonical(Astro.url.pathname, 'es')} />
      <link rel="alternate" hreflang="en" href={publicCanonical(Astro.url.pathname, 'en')} />
      <link rel="alternate" hreflang="x-default" href={publicCanonical(Astro.url.pathname, 'es')} />
    </>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {Astro.props.home && <link rel="preload" href="/fonts/oxanium-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={english ? 'en_GB' : 'es_ES'} />
    <meta property="og:site_name" content="AKRASIA STUDIO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="referrer" content="no-referrer" />
    {structuredData.map(entry => <script type="application/ld+json" set:html={JSON.stringify(entry).replace(/</g, '\\u003c')} />)}
  </head>
  <body class:list={['relative flex flex-col public-site', { 'home-screen': Astro.props.home }]}>
    <a href="#main-content" class="skip-link">{english ? 'Skip to content' : 'Saltar al contenido'}</a>
    <slot />
    <PrivacyConsent />
    <script>
      import { initializeLocalIcons } from '../lib/local-icons';
      import { parseChatIntentUrl } from '../lib/chat-navigation';
      initializeLocalIcons();
      // Navigation and links in answers share the same conversational entry point.
      document.addEventListener('click', event => {
        if (!(event.target instanceof Element) || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        if (!document.documentElement.hasAttribute('data-chat-ready')) return;
        const trigger = event.target.closest<HTMLElement>('[data-chat-message]');
        const anchor = event.target.closest<HTMLAnchorElement>('a[href]');
        const linked = anchor ? parseChatIntentUrl(anchor.href, window.location.origin, document.documentElement.lang === 'en' ? 'en' : 'es') : null;
        const message = trigger?.dataset.chatMessage || linked?.message;
        if (!message) return;
        event.preventDefault();
        document.dispatchEvent(new CustomEvent('chat-trigger', { detail: { message } }));
      });
    </script>
  </body>
</html>
<style is:global>
  body, .font-mono { font-family: 'JetBrains Mono', ui-monospace, 'Cascadia Code', 'Segoe UI Mono', Consolas, monospace; }
  .font-headline { font-family: 'Space Grotesk', system-ui, 'Segoe UI', sans-serif; }
  .material-symbols-outlined[data-local-icon] { display: inline-flex; align-items: center; justify-content: center; font-size: 0 !important; width: 1.1rem; height: 1.1rem; flex-shrink: 0; }
  .material-symbols-outlined[data-local-icon]::before { content: ''; display: block; width: 100%; height: 100%; background: currentColor; mask: var(--local-icon) center / contain no-repeat; -webkit-mask: var(--local-icon) center / contain no-repeat; }
</style>
