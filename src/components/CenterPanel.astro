---
import { pageLang } from '../lib/public-ui';
import { chatIntentPath, chatIntentMessage } from '../lib/chat-navigation';
const lang = pageLang(Astro.url);
const english = lang === 'en';
---
<section class="hud-viewport center-viewport studio-conversation-shell fade-in-panel" aria-label={english ? 'Akrasia studio' : 'Estudio Akrasia'}>
  <h1 id="viewportHudTitle" class="sr-only">Akrasia Studio</h1>
  <div class="studio-chat-fallback">
    <p class="studio-shell-label">AKRASIA // {english ? 'CONVERSATION' : 'CONVERSACIÓN'}</p>
    <a class="studio-fallback-action" href={chatIntentPath('start', lang)} data-chat-message={chatIntentMessage('start', lang)}>{english ? 'Start a conversation' : 'Iniciar conversación'} <span aria-hidden="true">↗</span></a>
    <noscript><p>{english ? 'Enable JavaScript to talk with the studio. You can also email us.' : 'Activa JavaScript para conversar con el estudio. También puedes escribirnos por correo.'} <a href="mailto:info@akrasia.studio">info@akrasia.studio</a></p></noscript>
  </div>
  <div id="chat-desktop-root"></div>
</section>
