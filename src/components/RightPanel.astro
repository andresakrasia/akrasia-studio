---
interface Project {
  id: string;
  title: string;
  slug: string;
  type: string;
  status: string;
  thumbnail: string;
  video_url: string;
  resolution: string;
  aspect: string;
  duration: string;
  category: string;
  sort_order: number;
  task_progress?: { total: number; completed: number };
}

interface LogEntry {
  id: string;
  text: string;
  log_type: string;
  created_at: string;
}

let projects: Project[] = [];
let logs: LogEntry[] = [];

try {
  const baseUrl = Astro.url.origin;
  const [projectsRes, logsRes] = await Promise.all([
    fetch(`${baseUrl}/api/projects`).catch(() => null),
    fetch(`${baseUrl}/api/logs`).catch(() => null),
  ]);
  if (projectsRes?.ok) projects = await projectsRes.json();
  if (logsRes?.ok) logs = await logsRes.json();
} catch {}

if (projects.length === 0) {
  try {
    const fallback = await import('../data/projects.json');
    projects = (fallback.default.projects || []).map((p: any) => ({
      ...p,
      slug: p.id,
      status: p.status === 'in_production' ? 'in_production' : 'completed',
      video_url: p.videoUrl,
      sort_order: 0,
    }));
  } catch {}
}

const statusColors: Record<string, string> = {
  in_production: 'bg-primary animate-pulse',
  planning: 'bg-yellow-500',
  post_production: 'bg-purple-500',
  completed: 'bg-primary',
  delivered: 'bg-green-500',
};

const timelineColors: Record<string, string> = {
  in_production: 'border-primary/40',
  planning: 'border-yellow-500/40',
  post_production: 'border-purple-500/40',
  completed: 'border-slate-800',
  delivered: 'border-green-500/40',
};

const statusLabels: Record<string, string> = {
  planning: 'Planificacion',
  in_production: 'En produccion',
  post_production: 'Post-produccion',
  completed: 'Completado',
  delivered: 'Entregado',
};

const completedProjects = projects.filter((p) => p.status === 'completed' || p.status === 'delivered').slice(0, 6);
const initialLogs = logs.slice(0, 6);
---

<aside class="col-span-12 lg:col-span-3 flex flex-col gap-4 lg:overflow-hidden lg:h-full fade-in-panel">
  <!-- Portfolio Reciente -->
  <div class="glass-panel p-4 lg:p-5 flex-1 flex flex-col overflow-hidden min-h-0 h-64 lg:h-auto">
    <div class="text-xs text-primary opacity-50 mb-5 uppercase tracking-[0.2em] flex justify-between items-center">
      <span>Portfolio_Reciente</span>
      <span class="material-symbols-outlined text-sm text-slate-600 cursor-pointer hover:text-primary transition-colors">
        tune
      </span>
    </div>
    <div class="flex-1 overflow-y-auto space-y-3 scroll-hide">
      {projects.map((project) => {
        const progress = project.task_progress;
        const pct = progress && progress.total > 0 ? Math.round((progress.completed / progress.total) * 100) : 0;
        const isActive = project.status === 'in_production' || project.status === 'planning' || project.status === 'post_production';
        return (
          <div
            class:list={[
              'relative pl-5 py-4 timeline-item',
              project.status === 'in_production'
                ? 'border-l border-primary/40 bg-primary/5 rounded-r'
                : `border-l ${timelineColors[project.status] || 'border-slate-800'}`,
            ]}
          >
            <div
              class:list={[
                'absolute -left-1 top-5 w-2 h-2 rounded-full',
                statusColors[project.status] || 'bg-slate-600',
              ]}
            ></div>
            <div
              class:list={[
                'text-xs font-bold',
                project.status === 'in_production' ? 'text-white' : 'text-slate-400',
              ]}
            >
              {project.title}
            </div>
            <div
              class:list={[
                'text-[11px]',
                project.status === 'in_production'
                  ? 'text-primary/70'
                  : 'text-slate-500',
              ]}
            >
              {project.type} | {project.duration} | {statusLabels[project.status] || project.status}
            </div>
            {isActive && progress && progress.total > 0 && (
              <div class="mt-2">
                <div class="flex justify-between text-[9px] mb-1">
                  <span class="text-slate-500">Progreso</span>
                  <span class="text-primary/70">{progress.completed}/{progress.total} tareas — {pct}%</span>
                </div>
                <div class="h-[2px] bg-white/5 rounded-full overflow-hidden">
                  <div class="h-full bg-primary progress-glow rounded-full transition-all" style={`width: ${pct}%`}></div>
                </div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>

  <!-- Trabajos (thumbnails) -->
  <div class="glass-panel p-4 lg:p-5 flex-1 flex flex-col overflow-hidden min-h-0 h-64 lg:h-auto order-first lg:order-none">
    <div class="text-xs text-primary opacity-50 mb-5 uppercase tracking-[0.2em]">
      Trabajos
    </div>
    <div class="flex-1 overflow-y-auto scroll-hide">
      <div class="grid grid-cols-2 gap-3">
        {completedProjects.map((project) => (
          <div
            class="thumb-card aspect-video glass-bubble overflow-hidden relative group"
            data-project-video={project.video_url}
            data-project-title={project.title}
          >
            <img
              class="object-cover w-full h-full opacity-40 transition-all duration-300 group-hover:opacity-70"
              src={project.thumbnail}
              alt={project.title}
              loading="lazy"
            />
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="w-12 h-12 rounded-full bg-primary/20 border border-primary/40 flex items-center justify-center backdrop-blur-sm">
                <span class="material-symbols-outlined text-primary text-xl">play_arrow</span>
              </div>
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-2 bg-gradient-to-t from-black/80 to-transparent">
              <div class="text-[9px] text-primary font-bold">
                {project.title}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- System Logs -->
  <div class="glass-panel p-4 lg:p-5 flex-none h-36 lg:h-40 overflow-hidden">
    <div class="text-xs text-primary opacity-50 mb-3">Estudio_Logs</div>
    <div class="text-[10px] space-y-1 font-mono leading-tight" id="systemLogs">
      {initialLogs.map((log) => {
        const time = new Date(log.created_at);
        const timeStr = `${String(time.getHours()).padStart(2, '0')}:${String(time.getMinutes()).padStart(2, '0')}:${String(time.getSeconds()).padStart(2, '0')}`;
        const isSuccess = log.log_type === 'success';
        const isWarning = log.log_type === 'warning';
        const label = isSuccess ? 'LISTO:' : isWarning ? 'AVISO:' : 'CORE:';
        const cls = isSuccess ? 'text-green-500' : isWarning ? 'text-yellow-500' : 'text-primary';
        return (
          <p class="text-slate-500">
            [{timeStr}] <span class={cls}>{label}</span> {log.text}
          </p>
        );
      })}
    </div>
  </div>
</aside>

<script>
  if (!(window as any).__rightPanelInit) {
    (window as any).__rightPanelInit = true;

    document.querySelectorAll('[data-project-video]').forEach((el) => {
      el.addEventListener('click', () => {
        document.dispatchEvent(
          new CustomEvent('video-open', {
            detail: {
              videoUrl: (el as HTMLElement).dataset.projectVideo,
              title: (el as HTMLElement).dataset.projectTitle,
            },
          })
        );
      });
    });

    async function loadLogs() {
      try {
        const res = await fetch('/api/logs');
        if (!res.ok) return [];
        return await res.json();
      } catch { return []; }
    }

    function logNow() {
      const d = new Date();
      return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}:${String(d.getSeconds()).padStart(2, '0')}`;
    }

    setInterval(async () => {
      const logsEl = document.getElementById('systemLogs');
      if (!logsEl) return;
      const entries = await loadLogs();
      if (!entries || entries.length === 0) return;
      const entry = entries[Math.floor(Math.random() * entries.length)];
      const typeConfig: Record<string, { label: string; cls: string }> = {
        success: { label: 'LISTO:', cls: 'text-green-500' },
        info: { label: 'CORE:', cls: 'text-primary' },
        warning: { label: 'AVISO:', cls: 'text-yellow-500' },
      };
      const cfg = typeConfig[entry.log_type] || typeConfig.info;
      const p = document.createElement('p');
      p.className = 'text-slate-500 log-entry-new';
      p.innerHTML = `[${logNow()}] <span class="${cfg.cls}">${cfg.label}</span> ${entry.text}`;
      logsEl.prepend(p);
      while (logsEl.children.length > 6) {
        logsEl.lastElementChild?.remove();
      }
    }, 5000);
  }
</script>
