---
---

<header
  class="h-14 flex items-center justify-between px-3 lg:px-4 z-50 relative glass-panel fade-in-header"
  role="banner"
>
  <div class="flex items-center gap-4 lg:gap-6">
    <div class="flex flex-col items-center justify-center cursor-pointer chat-trigger-logo" data-chat-message="Hola, quiero saber mas sobre Akrasia Studio">
      <span class="text-primary font-bold tracking-widest font-headline whitespace-nowrap inline-flex items-baseline leading-none">
          <span class="neon-char" style="font-size:0.7rem;letter-spacing:-0.04em;margin-right:-0.04em;--neon-delay:0s;--neon-dur:4.2s">Λ</span><span class="neon-char" style="font-size:0.84rem;letter-spacing:-0.05em;--neon-delay:0.3s;--neon-dur:3.8s">K</span><span class="neon-char" style="font-size:0.98rem;letter-spacing:-0.05em;--neon-delay:0.7s;--neon-dur:4.5s">R</span><span class="neon-char" style="font-size:1.12rem;letter-spacing:-0.05em;--neon-delay:1.1s;--neon-dur:3.5s">Λ</span><span class="neon-char" style="font-size:0.98rem;letter-spacing:-0.05em;--neon-delay:0.5s;--neon-dur:4.8s">S</span><span class="neon-char" style="font-size:0.84rem;letter-spacing:-0.05em;--neon-delay:0.9s;--neon-dur:3.9s">I</span><span class="neon-char" style="font-size:0.7rem;--neon-delay:1.4s;--neon-dur:4.1s">Λ</span>
        </span>
        <span class="neon-sub text-[7px] font-light tracking-[0.4em] font-headline uppercase leading-none mt-0.5">STUDIO</span>
    </div>
    <div
      class="hidden md:flex gap-4 text-xs text-slate-500 uppercase tracking-tighter"
    >
      <span class="text-primary/50">ENGINE: ACTIVE</span>
      <span>STUDIO: ONLINE</span>
      <span>SESSION: VISITOR</span>
    </div>
  </div>
  <div class="flex items-center gap-2 sm:gap-3 lg:gap-4 text-xs font-bold">
    <span
      class="text-primary animate-pulse items-center gap-1 hidden sm:flex"
    >
      <span class="material-symbols-outlined text-sm">circle</span> EN DIRECTO
    </span>
    <span class="text-slate-400 font-mono hidden sm:inline" id="headerClock"
      >18:17:58</span
    >
    <button
      class="bg-primary text-black px-3 lg:px-4 py-1 angular-cut hover:bg-white transition-colors uppercase tracking-wider text-[11px] lg:text-xs chat-trigger-btn btn-pulse"
      data-chat-message="Quiero iniciar un proyecto con vosotros"
    >
      Iniciar Proyecto
    </button>
  </div>
</header>

<script>
  if (!(window as any).__headerInit) {
    (window as any).__headerInit = true;
    function updateClock() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const s = String(now.getSeconds()).padStart(2, '0');
      const el = document.getElementById('headerClock');
      if (el) el.textContent = `${h}:${m}:${s}`;
    }
    updateClock();
    setInterval(updateClock, 1000);

    document.querySelectorAll('.chat-trigger-btn').forEach((el) => {
      el.addEventListener('click', () => {
        const msg = (el as HTMLElement).dataset.chatMessage;
        if (msg) {
          document.dispatchEvent(new CustomEvent('chat-trigger', { detail: { message: msg } }));
        }
      });
    });

    document.querySelectorAll('.chat-trigger-logo').forEach((el) => {
      el.addEventListener('click', () => {
        const msg = (el as HTMLElement).dataset.chatMessage;
        if (msg) {
          document.dispatchEvent(new CustomEvent('chat-trigger', { detail: { message: msg } }));
        }
      });
    });
  }
</script>
