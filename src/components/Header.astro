---
import { pageLang, alternateLanguagePath } from '../lib/public-ui';
import { textFor } from '../lib/i18n';
import { chatIntentPath, chatIntentMessage } from '../lib/chat-navigation';
interface Props { bilingual?: boolean }
const { bilingual = true } = Astro.props;
const lang = pageLang(Astro.url);
const english = lang === 'en';
---
<header class="hud-site-header studio-header glass-panel fade-in-header">
  <a class="hud-brand font-headline" href={chatIntentPath('about', lang)} data-chat-intent="about" data-chat-message={textFor('header.chatTrigger', lang)} aria-label={english ? 'Meet Akrasia Studio in the chat' : 'Conocer Akrasia Studio en el chat'}>
    <span class="hud-brand-wordmark" aria-hidden="true">
      <span class="neon-char" style="font-size:0.7rem;letter-spacing:-0.04em;margin-right:-0.04em;--neon-delay:0s;--neon-dur:4.2s">Λ</span><span class="neon-char" style="font-size:0.84rem;letter-spacing:-0.05em;--neon-delay:0.3s;--neon-dur:3.8s">K</span><span class="neon-char" style="font-size:0.98rem;letter-spacing:-0.05em;--neon-delay:0.7s;--neon-dur:4.5s">R</span><span class="neon-char" style="font-size:1.12rem;letter-spacing:-0.05em;--neon-delay:1.1s;--neon-dur:3.5s">Λ</span><span class="neon-char" style="font-size:0.98rem;letter-spacing:-0.05em;--neon-delay:0.5s;--neon-dur:4.8s">S</span><span class="neon-char" style="font-size:0.84rem;letter-spacing:-0.05em;--neon-delay:0.9s;--neon-dur:3.9s">I</span><span class="neon-char" style="font-size:0.7rem;--neon-delay:1.4s;--neon-dur:4.1s">Λ</span>
    </span>
    <span class="hud-brand-subtitle neon-sub" aria-hidden="true">STUDIO</span>
  </a>
  <p class="studio-header-discipline"><span aria-hidden="true">◈</span>{english ? 'Human direction · AI production' : 'Dirección humana · Producción con IA'}<span class="hub-telemetry" aria-hidden="true"><i></i>BCN <b data-hub-clock>--:--:--</b> · {english ? 'ONLINE' : 'EN LÍNEA'}</span></p>
  <nav aria-label={english ? 'Main navigation' : 'Navegación principal'} class="hud-header-navigation">
    <a href={chatIntentPath('services', lang)} data-chat-intent="services" data-chat-message={chatIntentMessage('services', lang)}>{english ? 'Services' : 'Servicios'}</a>
    <a href={chatIntentPath('portfolio', lang)} data-chat-intent="portfolio" data-chat-message={textFor('footer.proyectosMsg', lang)}>{english ? 'Work' : 'Proyectos'}</a>
    <a href={chatIntentPath('contact', lang)} data-chat-intent="contact" data-chat-message={textFor('footer.contactoMsg', lang)}>{english ? 'Contact' : 'Contacto'}</a>
  </nav>
  <div class="hud-header-actions">
    {bilingual && <a id="langToggleBtn" class="hud-language-toggle" href={alternateLanguagePath(Astro.url, lang)} hreflang={english ? 'es' : 'en'} lang={english ? 'es' : 'en'} aria-label={english ? 'Ver esta página en español' : 'Read this page in English'}>{english ? 'ES' : 'EN'}</a>}
    <a href={chatIntentPath('start', lang)} class="hud-header-cta chat-trigger-btn" data-chat-intent="start" data-chat-message={textFor('cta.startProject', lang)}>{textFor('header.cta', lang)} <span aria-hidden="true">↗</span></a>
  </div>
</header>
