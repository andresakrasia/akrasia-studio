<footer
  class="h-8 items-center justify-between px-4 text-[11px] text-slate-600 glass-panel z-50 hidden lg:flex"
>
  <div class="flex gap-4">
    <a class="nav-link chat-trigger-link" href="#" data-chat-message="Quiero conocer vuestro manifiesto, que es lo que os define como estudio">Manifiesto</a>
    <a class="nav-link chat-trigger-link" href="#" data-chat-message="Quiero ver vuestros proyectos, que tipo de trabajos haceis">Proyectos</a>
    <a class="nav-link chat-trigger-link" href="#" data-chat-message="Quiero contactar con vosotros">Contacto</a>
  </div>
  <div>
    AKRASIA.STUDIO <span class="text-slate-700">//</span> AI_CINEMA_ENGINE
    <span class="text-slate-700">//</span> &copy;2025
  </div>
  <div class="flex gap-4">
    <span>PING: 2ms</span>
    <span class="text-primary">SESION ACTIVA</span>
  </div>
</footer>

<footer class="lg:hidden p-4 text-[11px] text-slate-600 glass-panel z-50 mt-2 mb-16">
  <div class="flex justify-center gap-6 mb-2">
    <a class="nav-link chat-trigger-link" href="#" data-chat-message="Quiero conocer vuestro manifiesto, que es lo que os define como estudio">Manifiesto</a>
    <a class="nav-link chat-trigger-link" href="#" data-chat-message="Quiero ver vuestros proyectos, que tipo de trabajos haceis">Proyectos</a>
    <a class="nav-link chat-trigger-link" href="#" data-chat-message="Quiero contactar con vosotros">Contacto</a>
  </div>
  <div class="text-center text-[10px] text-slate-700">
    AKRASIA.STUDIO // AI_CINEMA_ENGINE // &copy;2025
  </div>
</footer>

<script>
  if (!(window as any).__footerChatInit) {
    (window as any).__footerChatInit = true;
    document.querySelectorAll('.chat-trigger-link').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const msg = (el as HTMLElement).dataset.chatMessage;
        if (msg) {
          document.dispatchEvent(new CustomEvent('chat-trigger', { detail: { message: msg } }));
        }
      });
    });
  }
</script>
