---
interface Service {
  id: string;
  title: string;
  description: string;
  icon: string;
  chat_message: string;
  highlighted: boolean;
  sort_order: number;
}

interface Stat {
  key: string;
  value: number;
  label: string;
}

interface FeedEntry {
  id: string;
  text: string;
  level: string;
  created_at: string;
  project_title?: string;
}

let services: Service[] = [];
let stats: Stat[] = [];
let feedEntries: FeedEntry[] = [];

try {
  const baseUrl = Astro.url.origin;
  const [servicesRes, statsRes, feedRes] = await Promise.all([
    fetch(`${baseUrl}/api/services`).catch(() => null),
    fetch(`${baseUrl}/api/stats`).catch(() => null),
    fetch(`${baseUrl}/api/feed`).catch(() => null),
  ]);
  if (servicesRes?.ok) {
    const data = await servicesRes.json();
    services = data.services || [];
  }
  if (statsRes?.ok) stats = await statsRes.json();
  if (feedRes?.ok) feedEntries = await feedRes.json();
} catch {}

if (services.length === 0) {
  try {
    const fallback = await import('../data/services.json');
    services = (fallback.default.services || []).map((s: any) => ({
      ...s,
      chat_message: s.chatMessage || s.chat_message || '',
      highlighted: s.highlighted || false,
      sort_order: s.sort_order || 0,
    }));
  } catch {}
}

const statMap: Record<string, Stat> = {};
for (const s of stats) statMap[s.key] = s;

const statProjects = statMap['active_projects'] || { value: 3, label: 'Proyectos en curso' };
const statPieces = statMap['pieces_delivered'] || { value: 24, label: 'Piezas entregadas' };
const statClients = statMap['active_clients'] || { value: 7, label: 'Clientes activos' };

const initialFeed = feedEntries.slice(0, 5);
---

<aside class="col-span-12 lg:col-span-2 flex flex-col gap-4 lg:overflow-hidden">
  <!-- Sobre Nosotros -->
  <div class="glass-panel p-4 lg:p-5 flex-none">
    <div class="text-xs text-primary mb-2 opacity-50 uppercase tracking-widest">
      Sobre_Nosotros
    </div>
    <p class="text-xs text-slate-400 leading-relaxed">
      No somos una agencia de prompts.<br />
      Somos directores, creadores y productores<br />
      que han convertido la IA en su ventaja definitiva.
    </p>
    <p class="text-[11px] text-primary/50 mt-2 italic">
      Hacemos lo que antes no era posible.
    </p>
    <div class="mt-3 flex gap-3">
      <div class="text-[10px] px-2 py-1 border border-primary/20 text-primary/70">
        AI Cinema
      </div>
      <div class="text-[10px] px-2 py-1 border border-slate-800 text-slate-500">
        Barcelona
      </div>
      <div class="text-[10px] px-2 py-1 border border-slate-800 text-slate-500">
        Est. 2025
      </div>
    </div>
  </div>

  <!-- Servicios -->
  <div class="glass-panel p-4 lg:p-5 flex-1 flex flex-col gap-4 lg:overflow-y-auto scroll-hide">
    <div class="text-xs text-primary opacity-50 uppercase tracking-widest">
      Servicios
    </div>
    <div class="space-y-1">
      {services.map((service, i) => (
        <div
          class:list={[
            'service-item flex items-center gap-3 py-2 px-2',
            service.highlighted || i === 0
              ? 'border-l-2 border-primary/40'
              : 'border-l-2 border-slate-700',
          ]}
          data-service-index={i}
          data-chat-message={service.chat_message}
        >
          <span
            class:list={[
              'material-symbols-outlined text-sm',
              service.highlighted || i === 0 ? 'text-primary' : 'text-slate-500',
            ]}
          >
            {service.icon}
          </span>
          <div>
            <div class="text-xs font-bold text-slate-300">{service.title}</div>
            <div class="text-[10px] text-slate-600">{service.description}</div>
          </div>
        </div>
      ))}
    </div>

    <!-- Estado del estudio -->
    <div class="mt-4 pt-4 border-t border-panel-border">
      <div class="text-xs text-primary opacity-50 mb-3 uppercase">
        Studio_Status
      </div>
      <div class="space-y-3">
        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{statProjects.label}</span>
            <span class="text-primary font-bold">{statProjects.value}</span>
          </div>
          <div class="h-[2px] bg-white/5 rounded-full overflow-hidden">
            <div class="h-full bg-primary progress-glow rounded-full" style={`width: ${Math.min(statProjects.value * 10, 100)}%`}></div>
          </div>
        </div>
        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{statPieces.label}</span>
            <span class="text-primary font-bold">{statPieces.value}</span>
          </div>
          <div class="h-[2px] bg-white/5 rounded-full overflow-hidden">
            <div class="h-full bg-primary/70 progress-glow rounded-full" style={`width: ${Math.min(statPieces.value * 2, 100)}%`}></div>
          </div>
        </div>
        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-300">{statClients.label}</span>
            <span class="text-primary font-bold">{statClients.value}</span>
          </div>
          <div class="h-[2px] bg-white/5 rounded-full overflow-hidden">
            <div class="h-full bg-primary/50 progress-glow rounded-full" style={`width: ${Math.min(statClients.value * 5, 100)}%`}></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feed IA en vivo -->
    <div class="mt-4 pt-4 border-t border-panel-border">
      <div class="text-xs text-primary opacity-50 mb-3 uppercase">
        AI_Generation_Live
      </div>
      <div class="space-y-2" id="aiFeed">
        {initialFeed.map((entry) => {
          const isHigh = entry.level === 'high';
          const isLow = entry.level === 'low';
          const time = new Date(entry.created_at);
          const timeStr = `${String(time.getHours()).padStart(2, '0')}:${String(time.getMinutes()).padStart(2, '0')}`;
          return (
            <div class={`text-[11px] border-l-2 pl-2 py-1 ${isHigh ? 'border-primary/30 bg-primary/5' : isLow ? 'border-slate-700' : 'border-primary/20'}`}>
              <span class={isLow ? 'text-slate-400' : 'text-primary/50'}>{timeStr}</span>
              {entry.project_title && <span class="text-primary/40 ml-1">[{entry.project_title}]</span>}
              <span class="text-slate-300"> {entry.text}</span>
            </div>
          );
        })}
        {initialFeed.length === 0 && (
          <div class="text-[11px] text-slate-500">Sin actividad reciente</div>
        )}
      </div>
    </div>
  </div>
</aside>

<script>
  if (!(window as any).__leftPanelInit) {
    (window as any).__leftPanelInit = true;

    const services = document.querySelectorAll('.service-item');
    let current = 0;
    setInterval(() => {
      services.forEach((s) => s.classList.remove('service-highlight'));
      if (services[current]) services[current].classList.add('service-highlight');
      current = (current + 1) % services.length;
    }, 2500);

    services.forEach((el) => {
      el.addEventListener('click', () => {
        const msg = (el as HTMLElement).dataset.chatMessage;
        if (msg) {
          document.dispatchEvent(new CustomEvent('chat-trigger', { detail: { message: msg } }));
        }
      });
    });

    async function loadFeed() {
      try {
        const res = await fetch('/api/feed');
        if (!res.ok) return [];
        return await res.json();
      } catch { return []; }
    }

    function feedNow() {
      const d = new Date();
      return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    }

    setInterval(async () => {
      const feed = document.getElementById('aiFeed');
      if (!feed) return;
      const entries = await loadFeed();
      if (!entries || entries.length === 0) return;
      const entry = entries[Math.floor(Math.random() * entries.length)];
      const isHigh = entry.level === 'high';
      const isLow = entry.level === 'low';
      const projTag = entry.project_title ? `<span class="text-primary/40 ml-1">[${entry.project_title}]</span>` : '';
      const div = document.createElement('div');
      div.className = `text-xs border-l-2 pl-2 py-1 ${isHigh ? 'border-primary/30 bg-primary/5' : isLow ? 'border-slate-700' : 'border-primary/20'}`;
      div.innerHTML = `<span class="${isLow ? 'text-slate-400' : 'text-primary/50'}">${feedNow()}</span>${projTag} <span class="text-slate-300">${entry.text}</span>`;
      feed.prepend(div);
      while (feed.children.length > 5) {
        feed.lastElementChild?.remove();
      }
    }, 7000);
  }
</script>
