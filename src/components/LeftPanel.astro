---
import { loadPublicServices, type PublicService } from '../lib/public-content';
import { pageLang } from '../lib/public-ui';
import { textFor } from '../lib/i18n';
import { chatIntentPath, chatIntentMessage } from '../lib/chat-navigation';
import StudioActivity from './StudioActivity.astro';
interface Props { publishedCount?: number | null }
const { publishedCount = null } = Astro.props;
const lang = pageLang(Astro.url);
const english = lang === 'en';
let services: PublicService[] = [];
let unavailable = false;
try { services = await loadPublicServices(); } catch { unavailable = true; }
---
<aside class="home-side hud-side studio-sidebar studio-sidebar-left" aria-label={english ? 'Studio and services' : 'Estudio y servicios'}>
  <section class="glass-panel hud-section studio-manifesto" id="studio">
    <h2 class="hud-section-title"><a href={chatIntentPath('manifesto', lang)} data-chat-intent="manifesto" data-chat-message={chatIntentMessage('manifesto', lang)}>{english ? 'Manifesto' : 'Manifiesto'} <span aria-hidden="true">↗</span></a></h2>
    <p class="studio-manifesto-copy">{textFor('left.aboutText', lang)}</p>
    <p class="studio-manifesto-close">{english ? 'We make what used to be impossible.' : 'Hacemos lo que antes no era posible.'}</p>
    <div class="studio-discipline"><span aria-hidden="true"></span>{english ? 'Human direction · AI production' : 'Dirección humana · Producción con IA'}</div>
  </section>
  <section class="glass-panel hud-section hud-services studio-services">
    <div class="studio-section-heading">
      <h2 class="hud-section-title"><a href={chatIntentPath('services', lang)} data-chat-intent="services" data-chat-message={chatIntentMessage('services', lang)}>{english ? 'Services' : 'Servicios'}</a></h2>
      <span class="studio-section-mark" aria-hidden="true">↗</span>
    </div>
    <p class="studio-section-caption">{english ? 'Choose one. Discover it in the chat.' : 'Elige uno. Descúbrelo en el chat.'}</p>
    <div class="studio-service-list">
      {services.map(service => <a class:list={['service-item studio-service', { 'studio-service-featured': service.highlighted }]} href={chatIntentPath(`service:${service.slug}`, lang)} data-chat-intent={`service:${service.slug}`} data-chat-message={chatIntentMessage(`service:${service.slug}`, lang)}>
        <span class="material-symbols-outlined studio-service-icon" aria-hidden="true">{service.icon}</span>
        <strong lang={english && !service.title_en ? 'es' : lang}>{english && service.title_en ? service.title_en : service.title}</strong>
        <span class="studio-service-arrow" aria-hidden="true">↗</span>
      </a>)}
      {services.length === 0 && <p class="studio-empty" role="status">{unavailable ? (english ? 'Service information is temporarily unavailable.' : 'La información de servicios no está disponible en este momento.') : (english ? 'Tell us about your audiovisual project.' : 'Cuéntanos tu proyecto audiovisual.')}</p>}
    </div>
  </section>
  <StudioActivity channel="feed" />
  <section class="glass-panel hud-section studio-location" aria-label={english ? 'Studio location and portfolio' : 'Ubicación del estudio y portfolio'}>
    <div class="studio-location-heading"><span class="hud-section-title">{english ? 'Location' : 'Ubicación'}</span><strong>BARCELONA</strong></div>
    <div class="studio-publication-count"><span>{english ? 'Published projects' : 'Proyectos publicados'}</span><strong id="publishedProjectCount">{publishedCount ?? '—'}</strong></div>
    <p id="publishedCountStatus" class="studio-empty" hidden={publishedCount !== null}>{english ? 'Portfolio unavailable' : 'Portfolio no disponible'}</p>
    <a href={chatIntentPath('contact', lang)} data-chat-intent="contact" data-chat-message={chatIntentMessage('contact', lang)} class="studio-contact-link">{english ? 'Talk to the studio' : 'Hablar con el estudio'} <span aria-hidden="true">↗</span></a>
  </section>
</aside>
<script>
  document.addEventListener('portfolio-refresh', ((event: CustomEvent) => {
    const count = document.getElementById('publishedProjectCount');
    const status = document.getElementById('publishedCountStatus');
    if (count) count.textContent = event.detail.unavailable ? '—' : String(event.detail.count);
    if (status) status.hidden = !event.detail.unavailable;
  }) as EventListener);
</script>
