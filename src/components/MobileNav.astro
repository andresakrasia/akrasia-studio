---
---

<div
  id="mobileNav"
  class="lg:hidden fixed right-4 left-4 z-[80] flex items-center justify-between px-2"
  style="bottom: calc(env(safe-area-inset-bottom, 0px) + 56px)"
  role="navigation"
  aria-label="Navegacion principal"
>
  <div class="flex gap-3">
    <button
      class="mobile-nav-btn w-12 h-12 bg-primary rounded-full flex items-center justify-center shadow-lg shadow-primary/30 hover:scale-110 transition-transform active"
      data-tab="info"
      aria-label="Panel de informacion"
    >
      <span class="material-symbols-outlined text-black text-xl">info</span>
    </button>
    <button
      class="mobile-nav-btn w-12 h-12 bg-primary rounded-full flex items-center justify-center shadow-lg shadow-primary/30 hover:scale-110 transition-transform"
      data-tab="portfolio"
      aria-label="Portfolio y trabajos"
    >
      <span class="material-symbols-outlined text-black text-xl">grid_view</span>
    </button>
  </div>
  <div id="mobileChatSlot"></div>
</div>

<style>
  .mobile-nav-btn {
    opacity: 0.45;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .mobile-nav-btn.active {
    opacity: 1;
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
  }
</style>

<script>
  if (!(window as any).__mobileNavInit) {
    (window as any).__mobileNavInit = true;

    function isMobile() {
      return window.innerWidth < 1024;
    }

    const btns = document.querySelectorAll('.mobile-nav-btn');
    const panels = {
      info: document.querySelector('[data-panel="info"]') as HTMLElement | null,
      portfolio: document.querySelector('[data-panel="portfolio"]') as HTMLElement | null,
    };

    function activateTab(tabName: string) {
      if (!isMobile()) return;
      btns.forEach(b => b.classList.toggle('active', (b as HTMLElement).dataset.tab === tabName));
      Object.entries(panels).forEach(([key, panel]) => {
        if (!panel) return;
        if (key === tabName) {
          panel.classList.remove('mobile-panel-hidden');
        } else {
          panel.classList.add('mobile-panel-hidden');
        }
      });
    }

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tabName = (btn as HTMLElement).dataset.tab;
        if (tabName) activateTab(tabName);
      });
    });

    if (isMobile()) activateTab('info');

    window.addEventListener('resize', () => {
      if (!isMobile()) {
        Object.values(panels).forEach(p => { if (p) p.classList.remove('mobile-panel-hidden'); });
      }
    });

    let touchStartX = 0;
    let touchStartY = 0;
    const tabOrder = ['info', 'portfolio'];

    document.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    document.addEventListener('touchend', (e) => {
      if (!isMobile()) return;
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      if (Math.abs(dx) < 60 || Math.abs(dy) > Math.abs(dx)) return;

      const activeBtn = document.querySelector('.mobile-nav-btn.active') as HTMLElement | null;
      if (!activeBtn) return;
      const currentIdx = tabOrder.indexOf(activeBtn.dataset.tab || 'info');
      const nextIdx = dx < 0 ? Math.min(currentIdx + 1, tabOrder.length - 1) : Math.max(currentIdx - 1, 0);
      activateTab(tabOrder[nextIdx]);
    }, { passive: true });
  }
</script>
