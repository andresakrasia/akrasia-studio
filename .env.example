OPENROUTER_API_KEY=sk-or-v1-your-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
# Generate with node scripts/hash-dashboard-password.mjs (16+ characters).
# Never reuse the retired dashboard URL secret or PIN.
DASHBOARD_PASSWORD_HASH=replace-with-generated-scrypt-hash
# Exact browser origin, no path. Local development: http://localhost:4321
DASHBOARD_ORIGIN=https://akrasia.studio
SITE_URL=https://akrasia.studio
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Akrasia Studio <noreply@akrasia.studio>
EMAIL_REPLY_TO=info@akrasia.studio
# Private mailbox notified when a visitor confirms a video call (v25).
BOOKING_ADMIN_EMAIL=info@akrasia.studio

# A02: server-only chat identity and fail-closed persistent quotas (migration-v10.sql).
# Generate a fresh secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_SESSION_SECRET=replace-with-64-random-hex-characters
# Exact browser origin. Local development: http://localhost:4321
CHAT_ORIGIN=https://akrasia.studio
CHAT_SESSION_SECONDS=86400
CHAT_SESSION_REQUESTS=20
CHAT_IP_REQUESTS=20
CHAT_WINDOW_SECONDS=3600
CHAT_GLOBAL_REQUESTS=200
# Conservative UTF-8 input/framing units + reserved maximum output tokens, not currency.
CHAT_GLOBAL_UNITS=1000000
CHAT_GLOBAL_WINDOW_SECONDS=86400
CHAT_SESSION_CONCURRENCY=1
CHAT_IP_CONCURRENCY=2
CHAT_GLOBAL_CONCURRENCY=4
CHAT_PROVIDER_TIMEOUT_MS=25000
CHAT_STORE_TIMEOUT_MS=5000
CHAT_LEASE_SECONDS=60
CHAT_MAX_BODY_BYTES=32768
CHAT_MAX_MESSAGES=20
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_HISTORY_BYTES=8192
CHAT_MAX_INPUT_UNITS=24000
CHAT_MAX_OUTPUT_TOKENS=500

# A09: do not enable until the actual container/tags and provider contracts are reviewed.
PUBLIC_GTM_CONTAINER_ID=
PUBLIC_GTM_CONTAINER_REVIEWED=false
# Optional direct GA4 integration. Copy the actual web stream ID (G-...) here.
# Enable only after reviewing the stream; disable Enhanced Measurement in GA4.
# When reviewed and valid, direct GA4 takes precedence over GTM to prevent duplicates.
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_GA4_REVIEWED=false
# Optional Search Console HTML tag token (content only, not the complete meta tag).
# Domain property verification uses Google's DNS TXT record instead of this value.
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional home showreel: comma-separated video paths (e.g. /media/showreel.mp4) or HTTPS URLs.
# Empty = no showreel. Played muted behind the chat until the visitor starts talking.
PUBLIC_SHOWREEL=
# Retention requires migration-v13.sql and an authenticated platform job.
# Technical periods confirmed by the controller on 2026-10-02; document their justification.
RETENTION_CRON_SECRET=replace-with-64-random-hex-characters
CHAT_RETENTION_DAYS=30
CHAT_PROFILE_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90
RETENTION_BATCH_SIZE=100

# Durable integrations (v15). Leave provider keys empty to disable delivery.
# A reviewed scheduler must POST with Authorization: Bearer <distinct secret>.
INTEGRATION_WORKER_SECRET=replace-with-64-random-hex-characters
INTEGRATION_WORKER_BATCH=5
# Jitsi creates a unique room per confirmed booking, on the official service by default.
# The host signs in to Jitsi and opens the room; visitors use their booking link.
JITSI_MEET_BASE_URL=https://meet.jit.si/
# Optional HTTPS override, only if you deliberately use an existing shared meeting link.
BOOKING_MEETING_URL=
